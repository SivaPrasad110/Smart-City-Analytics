# Smart City Analytics - Environment Variables Template
# Copy this file to .env and update values for your environment

# ===========================================
# APPLICATION SETTINGS
# ===========================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Local Development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartcity

# Production (Update these for cloud PostgreSQL)
# DATABASE_URL=postgresql://user:password@host:5432/smartcity

# ===========================================
# SECURITY KEYS (CRITICAL - CHANGE IN PRODUCTION)
# ===========================================
# Generate secure keys: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-chars
JWT_SECRET=your-jwt-secret-key-change-in-production-minimum-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ===========================================
# API CONFIGURATION
# ===========================================
API_V1_STR=/api/v1
API_HOST=0.0.0.0
API_PORT=8000

# ===========================================
# CORS SETTINGS
# ===========================================
# Development
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Production (Update with your domain)
# CORS_ORIGINS=https://smartcity.yourdomain.com,https://www.smartcity.yourdomain.com

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================
REACT_APP_API_URL=http://localhost:8000
REACT_APP_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png

# ===========================================
# ML MODEL CONFIGURATION
# ===========================================
MODEL_DIR=models
ML_MODEL_CACHE_SIZE=100
PREDICTION_TIMEOUT=30

# ===========================================
# FILE UPLOAD SETTINGS
# ===========================================
MAX_UPLOAD_SIZE=10485760
UPLOAD_FOLDER=uploads

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_PER_MINUTE=60

# ===========================================
# LOGGING CONFIGURATION
# ===========================================
LOG_FILE=logs/smartcity.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ===========================================
# SENTRY ERROR TRACKING (OPTIONAL)
# ===========================================
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project

# ===========================================
# REDIS CACHE (OPTIONAL)
# ===========================================
# REDIS_URL=redis://localhost:6379/0

# ===========================================
# EMAIL NOTIFICATIONS (OPTIONAL)
# ===========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=noreply@smartcity.com